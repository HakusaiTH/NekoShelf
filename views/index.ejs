<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="brand">
        <div class="brand-icon">
          <svg class="svg-icon" width="22" height="22" viewBox="0 0 24 24"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>
        </div>
        <span>BookHub</span>
      </a>
      <a href="/books/add" class="btn btn-primary">
        <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Add New Book
      </a>
    </div>
  </nav>

  <!-- Main Application Container -->
  <main class="app-container">

    <!-- Dashboard Hero Banner -->
    <section class="dashboard-hero">
      <div class="hero-header">
        <h1>
          <svg class="svg-icon" width="32" height="32" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <%= title %>
        </h1>
        <p>Explore, organize, and manage your group library collection with ease.</p>
      </div>

      <!-- Quick Statistics Summary -->
      <%
        const totalBooks = books.length;
        const genresList = [...new Set(books.map(b => b.genre).filter(Boolean))];
        const totalGenres = genresList.length;
        const classicBooks = books.filter(b => b.published_year && b.published_year < 2000).length;
      %>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">
            <svg class="svg-icon" width="24" height="24" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          </div>
          <div class="stat-info">
            <div class="stat-value" id="stat-total"><%= totalBooks %></div>
            <div class="stat-label">Total Books</div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <svg class="svg-icon" width="24" height="24" viewBox="0 0 24 24"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r="1.5"/></svg>
          </div>
          <div class="stat-info">
            <div class="stat-value"><%= totalGenres %></div>
            <div class="stat-label">Genres</div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <svg class="svg-icon" width="24" height="24" viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 10a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v11H9V10Z"/></svg>
          </div>
          <div class="stat-info">
            <div class="stat-value"><%= classicBooks %></div>
            <div class="stat-label">Classics (&lt; 2000)</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Toolbar: Search, Genre Filter, & View Mode Switcher -->
    <section class="toolbar">
      <!-- Instant Search -->
      <div class="search-box">
        <span class="search-icon">
          <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Search by title, author, or genre..."
          autocomplete="off"
        />
      </div>

      <!-- Genre Filter Dropdown & View Mode Buttons -->
      <div class="filter-group">
        <select id="genreFilter" class="select-custom">
          <option value="">All Genres</option>
          <% genresList.forEach(genre => { %>
            <option value="<%= genre %>"><%= genre %></option>
          <% }) %>
        </select>

        <div class="view-toggle">
          <button id="btnGridView" class="view-btn active" title="Grid View">
            <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          </button>
          <button id="btnTableView" class="view-btn" title="Table View">
            <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Book Catalog Section -->
    <% if (books.length === 0) { %>
      <!-- Global Empty State -->
      <div class="empty-state">
        <div class="empty-icon">
          <svg class="svg-icon" width="48" height="48" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        </div>
        <h2 class="empty-title">Your Library is Empty</h2>
        <p class="empty-desc">Get started by adding your first book to the collection!</p>
        <a href="/books/add" class="btn btn-primary">
          <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Add First Book
        </a>
      </div>
    <% } else { %>

      <!-- Dynamic Search Empty State (Hidden by default) -->
      <div id="noSearchResults" class="empty-state" style="display: none;">
        <div class="empty-icon">
          <svg class="svg-icon" width="48" height="48" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <h2 class="empty-title">No Matching Books Found</h2>
        <p class="empty-desc">Try adjusting your search query or genre filter.</p>
        <button onclick="resetFilters()" class="btn btn-edit">Reset Filters</button>
      </div>

      <!-- 1. Grid Card View -->
      <div id="gridView" class="book-grid">
        <% 
          const gradients = [
            'linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%)',
            'linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%)',
            'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)',
            'linear-gradient(135deg, #10b981 0%, #3b82f6 100%)',
            'linear-gradient(135deg, #6366f1 0%, #a855f7 100%)'
          ];
        %>
        <% books.forEach((book, index) => { %>
          <% const bgGradient = gradients[index % gradients.length]; %>
          <div 
            class="book-card book-item" 
            data-title="<%= book.title.toLowerCase() %>" 
            data-author="<%= book.author.toLowerCase() %>"
            data-genre="<%= (book.genre || '').toLowerCase() %>"
          >
            <!-- Card 3D Banner Header -->
            <div class="card-banner" style="background: <%= bgGradient %>;">
              <!-- 3D Mini Book Cover -->
              <div class="book-cover-3d">
                <div class="book-spine"></div>
                <div class="book-cover-content">
                  <span class="book-initial"><%= book.title.charAt(0).toUpperCase() %></span>
                </div>
              </div>
              
              <% if (book.genre) { %>
                <span class="badge-genre"><%= book.genre %></span>
              <% } %>
            </div>

            <!-- Card Content Body -->
            <div class="card-body">
              <h3 class="book-title"><%= book.title %></h3>
              
              <div class="book-author-row">
                <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span><%= book.author %></span>
              </div>

              <div class="book-meta-chips">
                <div class="meta-chip">
                  <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  <span><%= book.published_year || 'N/A' %></span>
                </div>
                <% if (book.genre) { %>
                  <div class="meta-chip meta-chip-genre">
                    <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r="1.5"/></svg>
                    <span><%= book.genre %></span>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="card-actions">
              <a class="btn btn-sm btn-edit" href="/books/<%= book.id %>/edit">
                <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit
              </a>
              <form action="/books/<%= book.id %>?_method=DELETE" method="POST" style="margin: 0;">
                <button 
                  type="submit" 
                  class="btn btn-sm btn-delete" 
                  onclick="return confirm('Are you sure you want to delete &quot;<%= book.title %>&quot;?');"
                >
                  <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                  Delete
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- 2. Table View (Hidden by default) -->
      <div id="tableView" class="table-container" style="display: none;">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Author</th>
              <th>Genre</th>
              <th>Published Year</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% books.forEach(book => { %>
              <tr 
                class="book-item"
                data-title="<%= book.title.toLowerCase() %>" 
                data-author="<%= book.author.toLowerCase() %>"
                data-genre="<%= (book.genre || '').toLowerCase() %>"
              >
                <td><strong><%= book.title %></strong></td>
                <td><%= book.author %></td>
                <td>
                  <% if (book.genre) { %>
                    <span class="badge-genre" style="color: var(--primary); background: var(--primary-light);"><%= book.genre %></span>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td><%= book.published_year || '-' %></td>
                <td style="text-align: right;">
                  <a class="btn btn-sm btn-edit" href="/books/<%= book.id %>/edit">
                    <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    Edit
                  </a>
                  <form action="/books/<%= book.id %>?_method=DELETE" method="POST" style="display: inline;">
                    <button 
                      type="submit" 
                      class="btn btn-sm btn-delete" 
                      onclick="return confirm('Are you sure you want to delete &quot;<%= book.title %>&quot;?');"
                    >
                      <svg class="svg-icon" width="14" height="14" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>

  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="nav-container" style="justify-content: center;">
      <p>© <%= new Date().getFullYear() %> MVC Book Library • Designed for Team Collaboration</p>
    </div>
  </footer>

  <!-- Interactive JavaScript for Live Filter & View Switching -->
  <script>
    const searchInput = document.getElementById('searchInput');
    const genreFilter = document.getElementById('genreFilter');
    const bookItems = document.querySelectorAll('.book-item');
    const noSearchResults = document.getElementById('noSearchResults');
    const statTotal = document.getElementById('stat-total');

    const btnGridView = document.getElementById('btnGridView');
    const btnTableView = document.getElementById('btnTableView');
    const gridView = document.getElementById('gridView');
    const tableView = document.getElementById('tableView');

    // Instant Search & Filter Logic
    function filterBooks() {
      const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const selectedGenre = (genreFilter ? genreFilter.value : '').toLowerCase().trim();
      let visibleCount = 0;

      bookItems.forEach(item => {
        const title = item.getAttribute('data-title');
        const author = item.getAttribute('data-author');
        const genre = item.getAttribute('data-genre');

        const matchesQuery = !query || title.includes(query) || author.includes(query) || genre.includes(query);
        const matchesGenre = !selectedGenre || genre === selectedGenre;

        if (matchesQuery && matchesGenre) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (statTotal) {
        statTotal.textContent = visibleCount;
      }

      if (noSearchResults) {
        noSearchResults.style.display = (visibleCount === 0 && bookItems.length > 0) ? 'block' : 'none';
      }
    }

    function resetFilters() {
      if (searchInput) searchInput.value = '';
      if (genreFilter) genreFilter.value = '';
      filterBooks();
    }

    if (searchInput) searchInput.addEventListener('input', filterBooks);
    if (genreFilter) genreFilter.addEventListener('change', filterBooks);

    // View Switching Logic (Grid vs Table)
    if (btnGridView && btnTableView && gridView && tableView) {
      btnGridView.addEventListener('click', () => {
        btnGridView.classList.add('active');
        btnTableView.classList.remove('active');
        gridView.style.display = 'grid';
        tableView.style.display = 'none';
      });

      btnTableView.addEventListener('click', () => {
        btnTableView.classList.add('active');
        btnGridView.classList.remove('active');
        gridView.style.display = 'none';
        tableView.style.display = 'block';
      });
    }
  </script>
</body>
</html>
