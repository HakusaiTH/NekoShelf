<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="form-page">
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="form-shell">
      <div class="form-card auth-card">
        <div class="form-heading">
          <div class="form-heading-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
              <polyline points="10 17 15 12 10 7"/>
              <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
          </div>
          <div>
            <span class="form-eyebrow">Account Access</span>
            <h1>Sign In to LibHub</h1>
            <p class="form-intro">Enter your credentials to manage or explore the library collection.</p>
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="form-alert-error">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="badge badge-success" style="padding: 0.75rem 1rem; width: 100%; margin-bottom: 1.25rem; font-size: 0.85rem;">
            <span><%= success %></span>
          </div>
        <% } %>

        <form action="/auth/login" method="POST" class="form">
          <div class="form-field">
            <label for="loginKey">Username or Email</label>
            <div class="input-wrap">
              <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <input type="text" id="loginKey" name="loginKey" required placeholder="Enter username or email..." value="<%= formData.loginKey || '' %>">
            </div>
          </div>

          <div class="form-field">
            <label for="password">Password</label>
            <div class="input-wrap">
              <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input type="password" id="password" name="password" required placeholder="Enter password...">
            </div>
          </div>

          <!-- Quick Fill Demo Accounts -->
          <div style="background: #FAF9F6; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); padding: 0.85rem; margin-top: 0.5rem;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-amber); text-transform: uppercase; margin-bottom: 0.5rem;">Quick Demo Fill</div>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button type="button" class="btn btn-xs btn-outline-primary" onclick="fillDemo('admin', 'admin123')">🔑 Admin Demo (admin / admin123)</button>
              <button type="button" class="btn btn-xs btn-secondary" onclick="fillDemo('user', 'user123')">👤 User Demo (user / user123)</button>
            </div>
          </div>

          <div class="form-actions">
            <a href="/auth/register" class="btn btn-ghost">Create Account</a>
            <button type="submit" class="btn btn-primary">Sign In &rarr;</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    function fillDemo(username, password) {
      document.getElementById('loginKey').value = username;
      document.getElementById('password').value = password;
    }
  </script>
</body>
</html>
