<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="form-page">
  <main class="form-shell">
    <section class="form-card" aria-labelledby="add-book-title">
      <div class="form-heading">
        <div>
          <p class="form-eyebrow">Library collection</p>
          <h1 id="add-book-title"><%= title %></h1>
          <p class="form-intro">Add a new title to your personal catalogue.</p>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-alert-error">
          <svg class="svg-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/books" method="POST" enctype="multipart/form-data" class="form">
        <div class="form-field">
          <label for="book-title">Title</label>
          <div class="input-wrap">
            <svg class="svg-icon input-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
            </svg>
            <input id="book-title" type="text" name="title" value="<%= (typeof formData !== 'undefined' && formData.title) ? formData.title : '' %>" placeholder="e.g. The Great Gatsby" required />
          </div>
        </div>

        <div class="form-field">
          <label for="book-author">Author</label>
          <div class="input-wrap">
            <svg class="svg-icon input-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 21a8 8 0 0 0-16 0" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <input id="book-author" type="text" name="author" value="<%= (typeof formData !== 'undefined' && formData.author) ? formData.author : '' %>" placeholder="e.g. F. Scott Fitzgerald" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="book-genre">Genre</label>
            <div class="input-wrap">
              <svg class="svg-icon input-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 3 8 4-8 4-8-4 8-4Z" />
                <path d="m4 12 8 4 8-4M4 17l8 4 8-4" />
              </svg>
              <select id="book-genre" name="genre" class="select-input">
                <option value="">Select Genre...</option>
                <% (typeof genres !== 'undefined' ? genres : ['Fiction', 'Non-Fiction', 'Technology', 'Classic', 'Dystopian', 'Fantasy', 'Sci-Fi', 'Mystery', 'Romance', 'Biography', 'History', 'Other']).forEach(g => { %>
                  <option value="<%= g %>" <%= (typeof formData !== 'undefined' && formData.genre === g) ? 'selected' : '' %>><%= g %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="published-year">Published Year</label>
            <div class="input-wrap">
              <svg class="svg-icon input-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="17" rx="2" />
                <path d="M16 2v4M8 2v4M3 10h18" />
              </svg>
              <input id="published-year" type="number" name="published_year" value="<%= (typeof formData !== 'undefined' && formData.published_year) ? formData.published_year : '' %>" placeholder="e.g. 1925" />
            </div>
          </div>
        </div>

        <!-- Cover Image Upload Field -->
        <div class="form-field">
          <label for="cover-image">Book Cover Image <span>(optional)</span></label>
          <div class="file-upload-wrap">
            <input id="cover-image" type="file" name="cover_image" accept="image/*" class="file-input" onchange="previewCoverImage(this)" />
            <label for="cover-image" class="file-dropzone">
              <div id="upload-placeholder" class="upload-placeholder">
                <svg class="svg-icon" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
                <p><strong>Click to upload cover image</strong></p>
                <span class="file-hint">PNG, JPG, WEBP or GIF (Max 5MB)</span>
              </div>
              <div id="image-preview-container" class="image-preview-container" style="display: none;">
                <img id="image-preview" src="#" alt="Cover Preview" />
                <button type="button" class="btn-remove-preview" onclick="removePreview(event)">Remove</button>
              </div>
            </label>
          </div>
        </div>

        <!-- Description Field -->
        <div class="form-field">
          <label for="book-description">Description / Summary <span>(optional)</span></label>
          <div class="input-wrap textarea-wrap">
            <textarea id="book-description" name="description" rows="3" placeholder="Brief story summary or book details..."></textarea>
          </div>
        </div>

        <div class="form-actions">
          <a class="btn btn-cancel" href="/">Cancel</a>
          <button class="btn btn-add" type="submit">
            <svg class="svg-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
              <path d="M17 21v-8H7v8M7 3v5h8" />
            </svg>
            Save Book
          </button>
        </div>
      </form>
    </section>
  </main>

  <script>
    function previewCoverImage(input) {
      const placeholder = document.getElementById('upload-placeholder');
      const previewContainer = document.getElementById('image-preview-container');
      const previewImage = document.getElementById('image-preview');

      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          previewImage.src = e.target.result;
          placeholder.style.display = 'none';
          previewContainer.style.display = 'flex';
        }
        reader.readAsDataURL(input.files[0]);
      }
    }

    function removePreview(event) {
      event.preventDefault();
      event.stopPropagation();
      const input = document.getElementById('cover-image');
      const placeholder = document.getElementById('upload-placeholder');
      const previewContainer = document.getElementById('image-preview-container');
      const previewImage = document.getElementById('image-preview');

      input.value = '';
      previewImage.src = '#';
      previewContainer.style.display = 'none';
      placeholder.style.display = 'block';
    }
  </script>
</body>
</html>
