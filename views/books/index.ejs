<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="container">
      
      <!-- Page Title Header -->
      <div class="page-header flex-between">
        <div>
          <h1 class="page-title">Books Catalog</h1>
          <p class="page-subtitle">Manage books, inventory copies, and relational classifications.</p>
        </div>
        <a href="/books/add" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          Add New Book
        </a>
      </div>

      <!-- Filter & Search Toolbar -->
      <div class="card toolbar-card">
        <form action="/books" method="GET" class="filter-form">
          <div class="filter-group flex-1">
            <div class="search-input-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" name="search" placeholder="Search by title, author, or ISBN..." value="<%= search %>" class="form-control">
            </div>
          </div>

          <div class="filter-group">
            <select name="category_id" class="form-control" onchange="this.form.submit()">
              <option value="">All Categories</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= String(selectedCategory) === String(cat.id) ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="filter-group">
            <button type="submit" class="btn btn-secondary">Filter</button>
            <% if (search || selectedCategory) { %>
              <a href="/books" class="btn btn-ghost">Clear</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Books Grid -->
      <div class="books-grid">
        <% if (books && books.length > 0) { %>
          <% books.forEach(book => { %>
            <div class="card book-card">
              <div class="book-cover-container">
                <% if (book.cover_image) { %>
                  <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="book-cover-img">
                <% } else { %>
                  <div class="book-cover-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    <span>No Cover</span>
                  </div>
                <% } %>
                <div class="book-stock-badge">
                  <span class="badge badge-<%= book.available_copies > 0 ? 'success' : 'danger' %>">
                    <%= book.available_copies %> / <%= book.total_copies %> Available
                  </span>
                </div>
              </div>

              <div class="book-card-body">
                <span class="book-category-tag"><%= book.category_name || 'Uncategorized' %></span>
                <h3 class="book-title"><%= book.title %></h3>
                <p class="book-author">by <strong><%= book.author_name || 'Unknown Author' %></strong></p>
                
                <% if (book.isbn) { %>
                  <p class="book-isbn">ISBN: <%= book.isbn %></p>
                <% } %>

                <% if (book.description) { %>
                  <p class="book-desc"><%= book.description.length > 110 ? book.description.substring(0, 110) + '...' : book.description %></p>
                <% } %>

                <div class="book-card-actions">
                  <a href="/books/<%= book.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                  
                  <form action="/books/<%= book.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this book?');" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>

                  <% if (book.available_copies > 0) { %>
                    <a href="/loans/add?book_id=<%= book.id %>" class="btn btn-sm btn-primary ml-auto">Checkout</a>
                  <% } else { %>
                    <button disabled class="btn btn-sm btn-secondary ml-auto" style="opacity:0.5; cursor:not-allowed;">Out of Stock</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state card">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <h3>No books found</h3>
            <p>Try adjusting your search query or filter parameters.</p>
            <a href="/books/add" class="btn btn-primary mt-3">Add First Book</a>
          </div>
        <% } %>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
