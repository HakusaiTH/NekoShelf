<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="container form-container">
      
      <div class="card form-card">
        <div class="card-header border-bottom flex-between">
          <div>
            <h1 class="card-title">Edit Book: <%= book.title %></h1>
            <p class="card-subtitle">Update book details, relational assignments, and stock quantities.</p>
          </div>
          <a href="/books" class="btn btn-ghost">&larr; Back to Catalog</a>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/books/<%= book.id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="app-form">
          <input type="hidden" name="existing_cover_image" value="<%= book.cover_image || '' %>">

          <div class="form-grid">

            <div class="form-group col-span-2">
              <label for="title" class="form-label">Book Title <span class="required">*</span></label>
              <input type="text" id="title" name="title" required value="<%= book.title %>" class="form-control">
            </div>

            <div class="form-group">
              <label for="author_id" class="form-label">Author <span class="required">*</span></label>
              <select id="author_id" name="author_id" class="form-control" required>
                <option value="">-- Select Author --</option>
                <% authors.forEach(author => { %>
                  <option value="<%= author.id %>" <%= String(book.author_id) === String(author.id) ? 'selected' : '' %>>
                    <%= author.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="category_id" class="form-label">Category / Genre <span class="required">*</span></label>
              <select id="category_id" name="category_id" class="form-control" required>
                <option value="">-- Select Category --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= String(book.category_id) === String(cat.id) ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="isbn" class="form-label">ISBN</label>
              <input type="text" id="isbn" name="isbn" value="<%= book.isbn || '' %>" class="form-control">
            </div>

            <div class="form-group">
              <label for="published_year" class="form-label">Publication Year</label>
              <input type="number" id="published_year" name="published_year" value="<%= book.published_year || '' %>" class="form-control">
            </div>

            <div class="form-group">
              <label for="total_copies" class="form-label">Total Inventory Copies</label>
              <input type="number" id="total_copies" name="total_copies" min="1" value="<%= book.total_copies || 1 %>" class="form-control">
            </div>

            <div class="form-group">
              <label for="available_copies" class="form-label">Available Copies</label>
              <input type="number" id="available_copies" name="available_copies" min="0" value="<%= book.available_copies !== undefined ? book.available_copies : 1 %>" class="form-control">
            </div>

            <div class="form-group col-span-2">
              <label for="cover_image" class="form-label">Change Cover Image File</label>
              <% if (book.cover_image) { %>
                <div class="mb-2 current-cover-preview">
                  <img src="<%= book.cover_image %>" alt="Current Cover" style="height:80px; border-radius:6px;">
                  <span class="text-sm text-muted">Current cover</span>
                </div>
              <% } %>
              <input type="file" id="cover_image" name="cover_image" accept="image/*" class="form-control">
            </div>

            <div class="form-group col-span-2">
              <label for="description" class="form-label">Description / Summary</label>
              <textarea id="description" name="description" rows="4" class="form-control"><%= book.description || '' %></textarea>
            </div>

          </div>

          <div class="form-actions mt-4">
            <button type="submit" class="btn btn-primary btn-lg">Update Book</button>
            <a href="/books" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
