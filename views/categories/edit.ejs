<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="container form-container">
      <div class="card form-card">
        <div class="card-header border-bottom flex-between">
          <div>
            <h1 class="card-title">Edit Category: <%= category.name %></h1>
            <p class="card-subtitle">Update genre classification details.</p>
          </div>
          <a href="/categories" class="btn btn-ghost">&larr; Back to Categories</a>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger">
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/categories/<%= category.id %>?_method=PUT" method="POST" class="app-form">
          <div class="form-group">
            <label for="name" class="form-label">Category Name <span class="required">*</span></label>
            <input type="text" id="name" name="name" required value="<%= category.name %>" class="form-control">
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="description" rows="4" class="form-control"><%= category.description || '' %></textarea>
          </div>

          <div class="form-actions mt-4">
            <button type="submit" class="btn btn-primary btn-lg">Update Category</button>
            <a href="/categories" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
