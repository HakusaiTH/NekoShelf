<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub Management System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>

  <main class="main-content">
    <div class="container">
      
      <!-- Welcome Banner -->
      <section class="dashboard-hero">
        <div class="hero-text">
          <span class="hero-badge">Library Management Portal</span>
          <h1>Welcome to LibHub System</h1>
          <p>Monitor real-time book availability, member checkouts, and overdue loans at a glance.</p>
        </div>
        <div class="hero-actions">
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <a href="/loans/add" class="btn btn-primary btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              Issue New Loan
            </a>
            <a href="/books/add" class="btn btn-secondary btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              Add Book
            </a>
          <% } else { %>
            <a href="/books" class="btn btn-primary btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              Browse Books Catalog
            </a>
          <% } %>
        </div>
      </section>

      <!-- Stats Metric Cards -->
      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon icon-blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Total Titles</span>
            <span class="stat-value"><%= stats.totalBooks %></span>
            <span class="stat-meta"><%= stats.totalCopies %> Total Copies</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-emerald">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Available Copies</span>
            <span class="stat-value"><%= stats.availableCopies %></span>
            <span class="stat-meta">Ready for checkout</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-amber">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Active Loans</span>
            <span class="stat-value"><%= stats.activeLoans %></span>
            <span class="stat-meta">Currently checked out</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-rose">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Overdue Loans</span>
            <span class="stat-value"><%= stats.overdueLoans %></span>
            <span class="stat-meta text-rose">Requires return</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Registered Members</span>
            <span class="stat-value"><%= stats.totalMembers %></span>
            <span class="stat-meta"><%= stats.totalAuthors %> Authors registered</span>
          </div>
        </div>
      </section>

      <!-- Grid Layout for Recent Activity and Inventory Alert -->
      <div class="dashboard-columns">
        
        <!-- Recent Loans Section -->
        <section class="card shadow-sm dashboard-card flex-1">
          <div class="card-header border-bottom flex-between">
            <h2>Recent Loan Transactions</h2>
            <a href="/loans" class="link-btn">View All Loans &rarr;</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Book Title</th>
                  <th>Member</th>
                  <th>Due Date</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (stats.recentLoans && stats.recentLoans.length > 0) { %>
                  <% stats.recentLoans.forEach(loan => { %>
                    <tr>
                      <td class="font-medium"><%= loan.book_title %></td>
                      <td><%= loan.member_name %> (<%= loan.member_code %>)</td>
                      <td><%= loan.due_date %></td>
                      <td>
                        <span class="badge badge-<%= loan.status === 'returned' ? 'success' : (loan.status === 'overdue' ? 'danger' : 'warning') %>">
                          <%= loan.status.toUpperCase() %>
                        </span>
                      </td>
                      <td>
                        <% if (loan.status !== 'returned') { %>
                          <form action="/loans/<%= loan.id %>/return" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-xs btn-outline-success">Return</button>
                          </form>
                        <% } else { %>
                          <span class="text-muted text-sm">Completed</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="empty-text">No recent loans recorded yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Low Stock Books Alert Section -->
        <section class="card shadow-sm dashboard-card flex-1">
          <div class="card-header border-bottom flex-between">
            <h2>Limited Copies Warning</h2>
            <a href="/books" class="link-btn">View All Books &rarr;</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Available</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <% if (lowStockBooks && lowStockBooks.length > 0) { %>
                  <% lowStockBooks.forEach(book => { %>
                    <tr>
                      <td class="font-medium"><%= book.title %></td>
                      <td><%= book.author_name || 'N/A' %></td>
                      <td>
                        <span class="badge badge-<%= book.available_copies === 0 ? 'danger' : 'warning' %>">
                          <%= book.available_copies %> left
                        </span>
                      </td>
                      <td><%= book.total_copies %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="empty-text">All books have sufficient available copies.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

      </div>

    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
