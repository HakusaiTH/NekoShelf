<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="container">
      
      <div class="page-header flex-between">
        <div>
          <h1 class="page-title">Categories & Genres</h1>
          <p class="page-subtitle">Organize your book collection into relational genres.</p>
        </div>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/categories/add" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add New Category
          </a>
        <% } %>
      </div>

      <div class="card shadow-sm">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th>Books Count</th>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                  <th class="text-right">Actions</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <tr>
                    <td class="font-semibold text-lg"><%= cat.name %></td>
                    <td><%= cat.description || 'No description provided.' %></td>
                    <td>
                      <a href="/books?category_id=<%= cat.id %>" class="badge badge-purple text-decoration-none">
                        <%= cat.book_count || 0 %> Books
                      </a>
                    </td>
                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                      <td class="text-right">
                        <a href="/categories/<%= cat.id %>/edit" class="btn btn-xs btn-outline-primary">Edit</a>
                        <form action="/categories/<%= cat.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Deleting a category will unassign books in this genre. Continue?');" style="display:inline;">
                          <button type="submit" class="btn btn-xs btn-outline-danger">Delete</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="empty-text">No categories added yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
