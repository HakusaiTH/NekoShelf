<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="container">
      
      <div class="page-header flex-between">
        <div>
          <h1 class="page-title">Library Members</h1>
          <p class="page-subtitle">Manage registered borrowers and member profiles.</p>
        </div>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/members/add" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Register New Member
          </a>
        <% } %>
      </div>

      <div class="card shadow-sm">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Member Code</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Active Loans</th>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                  <th class="text-right">Actions</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% if (members && members.length > 0) { %>
                <% members.forEach(mem => { %>
                  <tr>
                    <td><span class="badge badge-secondary font-mono"><%= mem.member_code %></span></td>
                    <td class="font-semibold text-lg"><%= mem.name %></td>
                    <td><%= mem.email || 'N/A' %></td>
                    <td><%= mem.phone || 'N/A' %></td>
                    <td>
                      <span class="badge badge-<%= mem.active_loans_count > 0 ? 'warning' : 'success' %>">
                        <%= mem.active_loans_count || 0 %> Active
                      </span>
                    </td>
                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                      <td class="text-right">
                        <a href="/members/<%= mem.id %>/edit" class="btn btn-xs btn-outline-primary">Edit</a>
                        <form action="/members/<%= mem.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Deleting a member removes their profile. Continue?');" style="display:inline;">
                          <button type="submit" class="btn btn-xs btn-outline-danger">Delete</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="empty-text">No registered members found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
