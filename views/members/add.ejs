<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - LibHub System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="container form-container">
      <div class="card form-card">
        <div class="card-header border-bottom flex-between">
          <div>
            <h1 class="card-title">Register New Member</h1>
            <p class="card-subtitle">Add a new library borrower account.</p>
          </div>
          <a href="/members" class="btn btn-ghost">&larr; Back to Members</a>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger">
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/members" method="POST" class="app-form">
          <div class="form-grid">
            <div class="form-group">
              <label for="name" class="form-label">Full Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required value="<%= formData.name || '' %>" placeholder="e.g. Somchai Srisuk" class="form-control">
            </div>

            <div class="form-group">
              <label for="member_code" class="form-label">Member Code (Optional)</label>
              <input type="text" id="member_code" name="member_code" value="<%= formData.member_code || '' %>" placeholder="e.g. MEM-1004 (Auto-generated if blank)" class="form-control">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" id="email" name="email" value="<%= formData.email || '' %>" placeholder="somchai@example.com" class="form-control">
            </div>

            <div class="form-group">
              <label for="phone" class="form-label">Phone Number</label>
              <input type="text" id="phone" name="phone" value="<%= formData.phone || '' %>" placeholder="081-234-5678" class="form-control">
            </div>
          </div>

          <div class="form-actions mt-4">
            <button type="submit" class="btn btn-primary btn-lg">Register Member</button>
            <a href="/members" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
