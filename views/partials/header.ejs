<header class="site-header">
  <nav class="navbar">
    <div class="nav-container">
      <!-- Logo & Brand -->
      <a href="/" class="brand">
        <div class="brand-text">
          <span class="brand-title">LibHub</span>
          <span class="brand-subtitle">Relational MVC System</span>
        </div>
      </a>

      <!-- Primary Navigation Links -->
      <div class="nav-links">
        <a href="/" class="nav-item <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="9" rx="1"/>
            <rect x="14" y="3" width="7" height="5" rx="1"/>
            <rect x="14" y="12" width="7" height="9" rx="1"/>
            <rect x="3" y="16" width="7" height="5" rx="1"/>
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/books" class="nav-item <%= typeof activeTab !== 'undefined' && activeTab === 'books' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          <span>Books</span>
        </a>

        <a href="/authors" class="nav-item <%= typeof activeTab !== 'undefined' && activeTab === 'authors' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span>Authors</span>
        </a>

        <a href="/categories" class="nav-item <%= typeof activeTab !== 'undefined' && activeTab === 'categories' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          <span>Categories</span>
        </a>

        <a href="/members" class="nav-item <%= typeof activeTab !== 'undefined' && activeTab === 'members' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 1 0 7.75"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span>Members</span>
        </a>

        <a href="/loans" class="nav-item <%= typeof activeTab !== 'undefined' && activeTab === 'loans' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
          </svg>
          <span>Loans</span>
        </a>
      </div>

      <!-- Action & Auth Navigation -->
      <div class="nav-actions">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <a href="/loans/add" class="btn btn-primary nav-add-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14"/>
                <path d="M5 12h14"/>
              </svg>
              <span>Issue Loan</span>
            </a>
          <% } %>

          <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.65rem; background: #F5F5F4; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm);">
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-main);"><%= currentUser.name || currentUser.username %></span>
            <% if (currentUser.role === 'admin') { %>
              <span class="badge badge-warning" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">🔑 Admin</span>
            <% } else { %>
              <span class="badge badge-secondary" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">👤 User</span>
            <% } %>
          </div>

          <a href="/auth/logout" class="btn btn-xs btn-outline-danger" title="Sign Out">Logout</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-sm btn-secondary">Sign In</a>
          <a href="/auth/register" class="btn btn-sm btn-primary">Register</a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
